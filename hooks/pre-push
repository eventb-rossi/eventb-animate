#!/usr/bin/env bash
set -euo pipefail

# Only validate release consistency for tag pushes.
# Normal branch pushes pass through unaffected.

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/tags/v*)
      TAG="${remote_ref#refs/tags/}"
      scripts/check-version.sh "$TAG"
      # The release workflow runs this too; failing here keeps a tag that
      # would be rejected there from reaching the remote in the first place.
      ruby scripts/extract-ci-shell.rb "$(mktemp -d)"
      ;;
  esac
done
